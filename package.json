{
  "name": "web3-payment-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on Web3 lessons: payment requests and a meal-voucher token on a local blockchain",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc -p . && tsc -p web",
    "node": "hardhat node",
    "deploy:node": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "web": "vite",
    "web:build": "vite build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.5",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "qrcode": "^1.5.4",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
