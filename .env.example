# Copy to .env and fill in to deploy to Sepolia. Never commit .env.
# RPC URL from Alchemy / Infura / any Sepolia provider:
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Private key of a TEST-ONLY wallet that holds Sepolia ETH (never a wallet with real funds):
DEPLOYER_PRIVATE_KEY=0x...
# Optional, for `npm run verify:sepolia` (etherscan.io → API keys):
ETHERSCAN_API_KEY=
